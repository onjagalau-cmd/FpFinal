<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DeliveryQuotes\DeliveryQuotes.csproj" />
  </ItemGroup>

  <!-- The native library must sit next to the test assembly for the real native-call tests. -->
  <PropertyGroup>
    <NativeDir>$(MSBuildThisFileDirectory)../../native/</NativeDir>
    <NativeFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">dqnative.dll</NativeFile>
    <NativeFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libdqnative.dylib</NativeFile>
    <NativeFile Condition="$([MSBuild]::IsOSPlatform('Linux'))">libdqnative.so</NativeFile>
  </PropertyGroup>
  <Target Name="CopyNative" AfterTargets="Build">
    <Copy Condition="Exists('$(NativeDir)lib/$(NativeFile)')" SourceFiles="$(NativeDir)lib/$(NativeFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
